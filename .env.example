# ==============================================================================
# KONFIGURASI GROQ CLOUD API (WAJIB)
# ==============================================================================
# API Key utama dari https://console.groq.com/keys
GROQ_API_KEY=gsk_your_primary_groq_api_key_here

# Opsional: Beberapa API Key dipisahkan koma untuk rotasi otomatis saat rate-limit (HTTP 429)
# GROQ_API_KEYS=gsk_key_satu,gsk_key_dua,gsk_key_tiga

# ==============================================================================
# KONFIGURASI MODEL & EMBEDDING (OPSIONAL - SUDAH ADA NILAI DEFAULT)
# ==============================================================================
# Model utama & cadangan Groq Cloud
GROQ_MODEL_NAME=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b

# Model embedding lokal HuggingFace (multilingual)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ==============================================================================
# PARAMETER RETRIEVAL & GATEKEEPER (OPSIONAL)
# ==============================================================================
CHUNK_SIZE=1500
CHUNK_OVERLAP=250
RETRIEVER_K=6
MIN_RELEVANCE_SCORE=0.12